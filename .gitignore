.DS_Store

# operational cron run logs (Robinhood is the data source; these are noise)
logs/cron/

# notification digests (delivered via Hermes, not part of the journal)
logs/digest/

# Python bytecode and test caches. scripts/robinhood_token.py is imported by the
# MCP proxies, so __pycache__ appears on any host that has run one — it showed up
# untracked on the iMac and nowhere else, which is exactly how a machine-specific
# artefact starts looking like a change somebody made.
__pycache__/
*.py[cod]
.pytest_cache/

# The decision journal itself. It names positions, quantities and balances, and
# this repo is public — so the logs stay on the machine that wrote them and the
# archive under $STOCK_DATA_DIR/trading-logs/ holds the history. Only the format
# contract (skills/log/SKILL.md) and the check parameters are tracked here.
logs/

# Real account numbers and sheet ids behind the placeholders. See accounts.example.md.
config/accounts.local.md
